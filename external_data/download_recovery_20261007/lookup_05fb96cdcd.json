{"data":{"id":"10.6084/m9.figshare.33329481","type":"dois","attributes":{"doi":"10.6084/m9.figshare.33329481","prefix":"10.6084","suffix":"m9.figshare.33329481","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Xincong Chen","givenName":"Xincong","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"clonal traits data of the invasive Spartina alterniflora in China"}],"publisher":"figshare","container":{},"publicationYear":2026,"subjects":[{"subject":"Population ecology","schemeUri":"http://www.abs.gov.au/ausstats/abs@.nsf/0/6BB427AB9696C225CA2574180004463E","subjectScheme":"ANZSRC Fields of Research","classificationCode":"310307"}],"contributors":[],"dates":[{"date":"2026-08-25","dateType":"Created"},{"date":"2026-08-25","dateType":"Updated"},{"date":"2026-08-25","dateType":"Issued"}],"language":null,"types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":["25576 Bytes"],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"This study used a multiple common-garden experiment with eight populations of Spartina alterniflora spanning its introduced range in China to examine phenotypic variation and covariance in key clonal traits. We found that low-latitude environments promoted earlier ramet emergence and greater ramet production, while low-latitude populations consistently exhibited a coordinated strategy of earlier emergence and higher ramet production. These findings highlight the potential role of clonal trait covariation in facilitating local adaptation of invasive plants across environmental gradients.","descriptionType":"Abstract"}],"geoLocati