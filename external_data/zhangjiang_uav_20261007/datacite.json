{"data":{"id":"10.57760/sciencedb.o00119.00069","type":"dois","attributes":{"doi":"10.57760/sciencedb.o00119.00069","prefix":"10.57760","suffix":"sciencedb.o00119.00069","identifiers":[{"identifier":"15732.11.sciencedb.00069","identifierType":"CSTR"}],"alternateIdentifiers":[{"alternateIdentifierType":"CSTR","alternateIdentifier":"15732.11.sciencedb.00069"}],"creators":[{"name":"Minmin Huang","affiliation":["Xiamen University"],"nameIdentifiers":[]},{"name":"Yihui Zhang","affiliation":["Xiamen University"],"nameIdentifiers":[]},{"name":"Zeyou Zhou","affiliation":["Fujian Environmental Protection Design Institute Company Limited"],"nameIdentifiers":[]},{"name":"Xudong Zhu","affiliation":["Xiamen University"],"nameIdentifiers":[]}],"titles":[{"title":"A dataset of the UAV remote sensing spatial distribution of Spartina alterniflora in the Zhangjiang Estuary of Fujian Province from 2013 to 2022"},{"lang":"zh","title":"2013–2022年福建漳江口互花米草分布无人机遥感数据集"}],"publisher":"Science Data Bank","container":{},"publicationYear":2023,"subjects":[{"subject":"Environmental science and resources science and technology","subjectScheme":"GB/T 13745-2009","classificationCode":"610"},{"subject":"coastal wetland"},{"subject":"Spartina alterniflora"},{"subject":"drone"},{"subject":"digital orthophoto"}],"contributors":[],"dates":[{"date":"2022-12-15","dateType":"Issued"},{"date":"2022-12-14","dateType":"Created"},{"date":"2023-07-27","dateType":"Updated"}],"language":"zh","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"relationType":"IsSupplementTo","relatedIdentifier":"10.11922/11-6035.csd.2023.0011.zh","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":["1844072803 bytes","20 files"],"formats":[],"version":"V4","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"This remote sensing image dataset includes orthomosaics and Spartina alterniflora spatial data, derived from drone-based RGB photos over Zhangjiang Estuary, Fujian Province from 2013 to 2022. The drone photos were collected via automatic flight planning mainly during daytime low-tide periods. Based on the structure-from-motion three-dimension reconstruction technique, for each campaign the drone photos can be mosaiced into a digital orthophoto map, which is then used for extracting the spatial distribution of Spartina alterniflora.        The dataset contains 2 folders including 10 orthomosaics and 10 Spartina alterniflora data, respectively. The file sizes are 1.7GB and 10.7MB for the orthomosaics and Spartina alterniflora data, respectively. All the data are in TIF format, and you can use GIS or remote sensing softwares like ArcGIS and ENVI to open them. The orthomosaics are named as \"date-DOM\" or the datasets with network RTK positioning service are named as \"date-DOM-RTK\". For example, the orthmosaic in June, 2022 is named as \"202206-DOM-RTK.tif\". Spartina alterniflora datasets are named \"date-classified\". The resolution of all data is 20 cm and the coordinate system is WGS84/UTM zone 50N. The drones used are different for these flights, and there is a slight deviation in positioning accuracy.","descriptionType":"Abstract"},{"lang":"zh","description":"This remote sensing image dataset includes orthomosaics and Spartina alterniflora spatial data, derived from drone-based RGB photos over Zhangjiang Estuary, Fujian Province from 2013 to 2022. The drone photos were collected via automatic flight planning mainly during daytime low-tide periods. Based on the structure-from-motion three-dimension reconstruction technique, for each campaign the drone photos can be mosaiced into a digital orthophoto map, which is then used for extracting the spatial distribution of Spartina alterniflora.        The dataset contains 2 folders including 10 orthomosaics and 10 Spartina alterniflora data, respectively. The file sizes are 1.7GB and 10.7MB for the orthomosaics and Spartina alterniflora data, respectively. All the data are in TIF format, and you can use GIS or remote sensing softwares like ArcGIS and ENVI to open them. The orthomosaics are named as \"date-DOM\" or the datasets with network RTK positioning service are named as \"date-DOM-RTK\". For example, the orthmosaic in June, 2022 is named as \"202206-DOM-RTK.tif\". Spartina alterniflora datasets are named \"date-classified\". The resolution of all data is 20 cm and the coordinate system is WGS84/UTM zone 50N. The drones used are different for these flights, and there is a slight deviation in positioning accuracy.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://www.scidb.cn/detail?dataSetId=434575a010a249a195fcb91b9efdc035","contentUrl":null,"metadataVersion":11,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":1937,"viewsOverTime":[{"yearMonth":"2022-12","total":45},{"yearMonth":"2023-02","total":58},{"yearMonth":"2023-03","total":32},{"yearMonth":"2023-04","total":47},{"yearMonth":"2023-05","total":34},{"yearMonth":"2023-06","total":11},{"yearMonth":"2023-07","total":31},{"yearMonth":"2023-08","total":127},{"yearMonth":"2023-09","total":101},{"yearMonth":"2023-10","total":89},{"yearMonth":"2023-11","total":67},{"yearMonth":"2023-12","total":71},{"yearMonth":"2024-01","total":88},{"yearMonth":"2024-02","total":72},{"yearMonth":"2024-03","total":101},{"yearMonth":"2024-04","total":186},{"yearMonth":"2024-05","total":67},{"yearMonth":"2024-06","total":88},{"yearMonth":"2024-07","total":103},{"yearMonth":"2024-08","total":116},{"yearMonth":"2024-09","total":109},{"yearMonth":"2024-10","total":43},{"yearMonth":"2024-11","total":129},{"yearMonth":"2024-12","total":71},{"yearMonth":"2025-01","total":51}],"downloadCount":1217,"downloadsOverTime":[{"yearMonth":"2022-12","total":2},{"yearMonth":"2023-07","total":3},{"yearMonth":"2023-08","total":79},{"yearMonth":"2023-09","total":3},{"yearMonth":"2023-10","total":59},{"yearMonth":"2023-11","total":21},{"yearMonth":"2023-12","total":4},{"yearMonth":"2024-01","total":58},{"yearMonth":"2024-02","total":5},{"yearMonth":"2024-03","total":94},{"yearMonth":"2024-04","total":50},{"yearMonth":"2024-05","total":34},{"yearMonth":"2024-06","total":82},{"yearMonth":"2024-07","total":86},{"yearMonth":"2024-08","total":32},{"yearMonth":"2024-09","total":412},{"yearMonth":"2024-10","total":40},{"yearMonth":"2024-11","total":77},{"yearMonth":"2024-12","total":8},{"yearMonth":"2025-01","total":68}],"referenceCount":0,"citationCount":2,"citationsOverTime":[{"year":"2025","total":2}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2022-12-15T01:56:31.000Z","registered":"2022-12-15T01:56:32.000Z","published":"2023","updated":"2025-04-27T23:07:29.000Z"},"relationships":{"client":{"data":{"id":"cnic.sciencedb","type":"clients"}},"provider":{"data":{"id":"cnic","type":"providers"}},"media":{"data":{"id":"10.57760/sciencedb.o00119.00069","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.1080/19475705.2025.2585167","type":"dois"},{"id":"10.11922/11-6035.csd.2023.0011.zh","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}